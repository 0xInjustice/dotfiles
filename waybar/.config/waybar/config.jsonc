{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": true,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "mpris",
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "battery",
    "clock",
    "tray",
    "custom/notification",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "show-special": true,
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false,
    "on-click": "activate",
    "format": "{name}"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 55,
    "separate-outputs": true
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": " {dynamic}",
    "dynamic-len": 40,
    "player-icons": {
      "default": ""
    }
  },

  "cpu": {
    "interval": 1,
    "format": " {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 2,
    "format": " {used:0.1f}G"
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀 Connected",
    "format-disconnected": "󰖪 Offline",
    "tooltip-format": "{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
    "bat": "BAT1",
    "interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "clock": {
    "interval": 1,
    "format": "󰥔 {:%H:%M}  |   {:%a %d %b}",
    "tooltip-format": "<span font='Lexend 15'><b>{:%A, %d %B %Y}</b></span>\n\n{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span>{}</span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "weeks": "<span color='#89dceb'><b>W{}</b></span>"
      }
    }
  },

  "tray": {
    "spacing": 10,
    "show-passive-items": true
  },

  "custom/notification": {
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰡟",
      "none": "󰅺",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛"
    },
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout -p layer-shell &"
  }
}
